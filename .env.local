# Optional. MBTA V3 works without a key at a lower rate limit (20 req/min).
# Get a free key at https://api-v3.mbta.com/register
MBTA_API_KEY=

# Optional. Without it, /api/explain uses built-in plain-language templates.
ANTHROPIC_API_KEY=
# Optional model override for /api/explain (default: claude-haiku-4-5)
ANTHROPIC_MODEL=
# Optional. AI rewrites per client per minute (default 10). Over the limit, riders get templates.
EXPLAIN_AI_LIMIT_PER_MINUTE=

# Testing only: set to 1 to skip the live MBTA call and use the committed snapshot.
FORCE_OFFLINE=

GOOGLE_MAPS_API_KEY=
